{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only vulnerability/security PRs. This extends the global Mintmaker config https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json",
  "extends": ["security:only-security-updates"],
  "labels": ["dependencies"],
  "enabledManagers": ["gomod"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": [
        "github.com/open-telemetry/opentelemetry-operator",
        "github.com/open-telemetry/opentelemetry-operator/apis"
      ],
      "enabled": false
    }
  ]
}
