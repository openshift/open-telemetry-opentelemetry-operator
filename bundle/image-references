# This file defines operator and component images
# ART replaces the pullspec (name) in CSV.
# Therefore the CSV has to contain these images e.g. in RELATED_IMAGE_ to make it work.
---
kind: ImageStream
apiVersion: image.openshift.io/v1
spec:
  tags:
  - name: opentelemetry-rhel9-operator
    from:
      kind: DockerImage
      name: ghcr.io/open-telemetry/opentelemetry-operator/opentelemetry-operator:0.158.0
  - name: opentelemetry-collector-rhel9
    from:
      kind: DockerImage
      name: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector:0.158.0
  - name: opentelemetry-target-allocator-rhel9
    from:
      kind: DockerImage
      name: ghcr.io/open-telemetry/opentelemetry-operator/target-allocator:0.158.0
